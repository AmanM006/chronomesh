# CockroachDB Cloud
DATABASE_URL=postgresql://username:password@free-tier.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# AWS Bedrock (for live Claude 3.5 Sonnet + Titan Embeddings)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=

# Bedrock Models
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ChronoMesh Runtime
NEXT_PUBLIC_APP_NAME=ChronoMesh
NEXT_PUBLIC_LIVE_CLUSTER=sage-manatee
